{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "npm ci --include=dev && npm run contracts:compile && npm run build" },
  "deploy": { "startCommand": "npm start", "healthcheckPath": "/api/health", "restartPolicyType": "ON_FAILURE", "restartPolicyMaxRetries": 3 }
}
